# ===== BẮT BUỘC (không có là bot không chạy) =====
DEEPSEEK_API_KEY=

# ===== NÊN CÓ =====
# Bot Telegram RIÊNG để nhận lead + tiếp quản (KHÔNG dùng chung bot Mây)
TELEGRAM_ALERT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# ===== TUỲ CHỌN =====
# Tầng "khó" — Claude Haiku. Không có thì mọi câu đều chạy DeepSeek.
ANTHROPIC_API_KEY=
# Tìm kiếm ngữ nghĩa cho knowledge base. Không có thì dùng tìm theo từ khoá.
JINA_API_KEY=

# Postgres của Railway. Để trống = dùng SQLite file (chạy local ngon lành).
DATABASE_URL=

# Domain được phép nhúng widget, cách nhau bằng dấu phẩy.
# Lúc dev để * cũng được, LÊN THẬT PHẢI ĐIỀN ĐÚNG DOMAIN.
ALLOWED_ORIGINS=*

# Tên bot hiện trên khung chat
BOT_NAME=Bé Giản

# Bật /docs và /openapi.json. LÊN THẬT PHẢI ĐỂ false.
PUBLIC_DOCS=false
